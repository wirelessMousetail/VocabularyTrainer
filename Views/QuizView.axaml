<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VocabularyTrainer.ViewModels"
        x:Class="VocabularyTrainer.Views.QuizView"
        x:DataType="vm:QuizViewModel"
        Title="VocabularyTrainer Quiz"
        Width="450"
        MinWidth="350" MinHeight="250" MaxHeight="800"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/tray.ico"
        PointerPressed="Window_PointerPressed">

    <Window.Styles>
        <Style Selector="Button.answer-option">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.answer-option:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A7BD5"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.answer-option:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="TextBlock.result">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Accent header: question -->
        <Border DockPanel.Dock="Top"
                Background="#3D3D8F"
                Padding="24,20,24,24">
            <StackPanel>
                <TextBlock Text="{Binding Question}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Answer area -->
        <StackPanel Margin="16,12,16,16">

                <ItemsControl ItemsSource="{Binding AnswerOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Classes="answer-option"
                                    Command="{Binding $parent[Window].DataContext.AnswerCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="{Binding ResultColor}"
                           Classes="result"
                           IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{Binding HintText}"
                           IsVisible="{Binding IsHintVisible}"
                           Classes="hint"/>
            </StackPanel>
    </DockPanel>
</Window>
