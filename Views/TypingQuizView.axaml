<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VocabularyTrainer.ViewModels"
        x:Class="VocabularyTrainer.Views.TypingQuizView"
        x:DataType="vm:TypingQuizViewModel"
        Title="VocabularyTrainer Quiz"
        Width="450"
        MinWidth="350" MinHeight="240" MaxHeight="800"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/tray.ico"
        PointerPressed="Window_PointerPressed">

    <Window.Styles>
        <Style Selector="Button.submit">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#3A7BD5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.submit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D63B0"/>
        </Style>
        <Style Selector="Button.submit:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.switch">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#B0B0B0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.switch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#909090"/>
        </Style>
        <Style Selector="Button.switch:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="TextBlock.result">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style Selector="TextBlock.answer-hint">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Styles>

    <Panel x:Name="RootPanel" Focusable="True">
        <DockPanel>
            <!-- Accent header: question -->
            <Border DockPanel.Dock="Top"
                    Background="#3D3D8F"
                    Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="{Binding Question}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Input area -->
            <StackPanel Margin="16,12,16,16">

                <TextBox x:Name="AnswerInput"
                         Text="{Binding TextInput}"
                         Watermark="Type your answer…"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,0,8"
                         CornerRadius="6"
                         IsEnabled="{Binding !IsQuizCompleted}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Return" Command="{Binding SubmitCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Content="Check"
                        Classes="submit"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding !IsQuizCompleted}"/>

                <Button Content="Switch to options"
                        Classes="switch"
                        Command="{Binding SwitchToOptionsCommand}"
                        IsEnabled="{Binding !IsQuizCompleted}"
                        Margin="0,6,0,0"/>

                <TextBlock Text="{Binding HintText}"
                           Classes="hint"
                           IsVisible="{Binding HintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="{Binding ResultColor}"
                           Classes="result"
                           IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{Binding AnswerHintText}"
                           IsVisible="{Binding IsAnswerHintVisible}"
                           Classes="answer-hint"/>
            </StackPanel>
        </DockPanel>
    </Panel>
</Window>
